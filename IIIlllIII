local function keyFromSetting(name, defaultName)
    local savedName = loadSetting(name, defaultName)
    if not savedName or savedName == "" then return nil end
    local ok, key = pcall(function() return Enum.KeyCode[savedName] end)
    if ok and key and key ~= Enum.KeyCode.Unknown then return key end
    return nil
end
