function stompEffects.AddPostEffects(name, tint, brightness, contrast, blurSize, lifetime)
    local lighting = game:GetService("Lighting")

    local color = Instance.new("ColorCorrectionEffect")
    color.Name = name .. "Color"
    color.TintColor = Color3.new(1, 1, 1)
    color.Brightness = 0
    color.Contrast = 0
    color.Saturation = 0
    color.Parent = lighting

    local bloom = Instance.new("BloomEffect")
    bloom.Name = name .. "Bloom"
    bloom.Intensity = 0
    bloom.Size = 42
    bloom.Threshold = 0.75
    bloom.Parent = lighting

    local blur = Instance.new("BlurEffect")
    blur.Name = name .. "Blur"
    blur.Size = 0
    blur.Parent = lighting

    TweenService:Create(color, TweenInfo.new(0.45), {
        TintColor = tint,
        Brightness = brightness,
        Contrast = contrast,
        Saturation = 0.12,
    }):Play()
    TweenService:Create(bloom, TweenInfo.new(0.35), {Intensity = 2.2}):Play()
    TweenService:Create(blur, TweenInfo.new(0.18), {Size = blurSize}):Play()
    task.delay(0.18, function()
        if blur.Parent then
            TweenService:Create(blur, TweenInfo.new(0.65), {Size = 0}):Play()
        end
    end)

    task.delay(lifetime - 1, function()
        if color.Parent then
            TweenService:Create(color, TweenInfo.new(1), {
                TintColor = Color3.new(1, 1, 1),
                Brightness = 0,
                Contrast = 0,
                Saturation = 0,
            }):Play()
        end
        if bloom.Parent then
            TweenService:Create(bloom, TweenInfo.new(1), {Intensity = 0}):Play()
        end
    end)
    stompEffects.DestroyLater(color, lifetime)
    stompEffects.DestroyLater(bloom, lifetime)
    stompEffects.DestroyLater(blur, lifetime)
end

