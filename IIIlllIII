        listening = true
        state.KeybindCapture = true
        state.CancelKeybindCapture = unbind
        previousText = keyButton.Text
        keyButton.Text = "PRESS KEY"
        keyButton.BackgroundColor3 = theme.AccentSecondary
    end)

    UserInputService.InputBegan:Connect(function(input)
        if not listening or input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        if input.KeyCode == Enum.KeyCode.Escape then
            listening = false
            state.KeybindCapture = false
            if state.CancelKeybindCapture == unbind then state.CancelKeybindCapture = nil end
            keyButton.Text = previousText
            keyButton.BackgroundColor3 = initialKey and theme.AccentPrimary or theme.BackgroundTertiary
            return
        end

        if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
            unbind()
            return
        end

        if input.KeyCode == Enum.KeyCode.Unknown then return end
        if validateKey then
            local allowed, reason = validateKey(input.KeyCode)
            if allowed == false then
                keyButton.Text = "KEY IN USE"
                notify("KEYBIND", reason or "That key is already assigned", 3, "warning")
                task.delay(0.8, function()
                    if listening and keyButton.Parent then
                        keyButton.Text = "PRESS A KEY"
                    end
                end)
                return
            end
        end
        listening = false
        state.KeybindCapture = false
        if state.CancelKeybindCapture == unbind then state.CancelKeybindCapture = nil end
        initialKey = input.KeyCode
        keyButton.Text = input.KeyCode.Name
        keyButton.BackgroundColor3 = theme.AccentPrimary
        tween(s, {Transparency = 0.2}, 0.2)
        callback(input.KeyCode)
    end)
    return unbind
end

-- Any left click outside the active key button cancels capture and unbinds it.
-- The defer lets the button's own MouseButton1Click handler run first.
UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        and state.KeybindCapture
        and state.CancelKeybindCapture then
        task.defer(function()
            if state.KeybindCapture and state.CancelKeybindCapture then
                state.CancelKeybindCapture()
            end
        end)
    end
end)

