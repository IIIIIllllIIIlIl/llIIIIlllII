            -- keeping the cursor visible over the menu.
            if menuMouse.Icon and menuMouse.Icon ~= ""
                and menuMouse.Icon ~= state.MenuCursor.Icon then
                state.MenuCursor.Icon = menuMouse.Icon
            end
            if state.MenuCursor.Icon and state.MenuCursor.Icon ~= "" then
                menuMouse.Icon = state.MenuCursor.Icon
            end
            UserInputService.MouseIconEnabled = true
        elseif state.MenuCursor.Icon ~= nil then
            menuMouse.Icon = state.MenuCursor.Icon
            state.MenuCursor.Icon = nil
        end
    end

    main:GetPropertyChangedSignal("Visible"):Connect(state.MenuCursor.KeepVisible)
    RunService:BindToRenderStep(
        ids.gui .. "_MenuCursor",
        Enum.RenderPriority.Last.Value,
        state.MenuCursor.KeepVisible
    )
end

