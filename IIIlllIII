    s.Color = enabledColor
    s.Thickness = 2
    s.Transparency = initialValue and 0.2 or 0.8
    local accentBar = Instance.new("Frame", f)
    accentBar.BackgroundColor3 = enabledColor
    accentBar.BackgroundTransparency = initialValue and 0 or 0.55
    accentBar.BorderSizePixel = 0
    accentBar.Position = UDim2.new(0, 0, 0, 9)
    accentBar.Size = UDim2.new(0, 3, 1, -18)
    Instance.new("UICorner", accentBar).CornerRadius = UDim.new(1, 0)

    local tl = Instance.new("TextLabel", f)
    tl.BackgroundTransparency = 1
    tl.Position = UDim2.new(0, 14, 0, 8)
    tl.Size = UDim2.new(1, -100, 0, 18)
    tl.Font = Enum.Font.GothamBold
    tl.Text = name
    tl.TextColor3 = theme.TextPrimary
    tl.TextSize = 13
    tl.TextXAlignment = Enum.TextXAlignment.Left

    local dl = Instance.new("TextLabel", f)
    dl.BackgroundTransparency = 1
    dl.Position = UDim2.new(0, 14, 0, 28)
    dl.Size = UDim2.new(1, -100, 0, 20)
    dl.Font = Enum.Font.Gotham
    dl.Text = desc
    dl.TextColor3 = theme.TextSecondary
    dl.TextSize = 12
    dl.TextXAlignment = Enum.TextXAlignment.Left

    local box = Instance.new("Frame", f)
    box.BackgroundColor3 = initialValue and enabledColor or disabledColor
    box.Position = UDim2.new(1, -48, 0.5, -14)
    box.Size = UDim2.new(0, 28, 0, 28)
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 7)

    local check = Instance.new("TextLabel", box)
    check.BackgroundTransparency = 1
    check.Size = UDim2.new(1, 0, 1, 0)
    check.Font = Enum.Font.GothamBold
    check.Text = initialValue and "✓" or ""
    check.TextColor3 = theme.TextPrimary
    check.TextSize = 19

    local val = initialValue
    local control = {}
    local function render(value)
        val = value
        check.Text = value and "✓" or ""
        tween(box, {BackgroundColor3 = value and enabledColor or disabledColor}, 0.2)
        tween(s, {Transparency = value and 0.2 or 0.8}, 0.3)
        tween(accentBar, {BackgroundColor3 = value and enabledColor or disabledColor}, 0.2)
        tween(accentBar, {BackgroundTransparency = value and 0 or 0.55}, 0.2)
    end
    function control.SetValue(value, invokeCallback)
        render(value)
        if invokeCallback then callback(value) end
    end
    function control.GetValue()
        return val
    end

    local click = Instance.new("TextButton", f)
    click.BackgroundTransparency = 1
    click.Size = UDim2.new(1, 0, 1, 0)
    click.Text = ""

    click.MouseButton1Click:Connect(function()
        control.SetValue(not val, true)
    end)
    click.MouseEnter:Connect(function()
        tween(s, {Transparency = 0.08}, 0.15)
        tween(f, {BackgroundColor3 = Color3.fromRGB(30, 36, 58)}, 0.15)
    end)
    click.MouseLeave:Connect(function()
        tween(s, {Transparency = val and 0.2 or 0.8}, 0.2)
        tween(f, {BackgroundColor3 = theme.BackgroundSecondary}, 0.2)
    end)
    return control
end

