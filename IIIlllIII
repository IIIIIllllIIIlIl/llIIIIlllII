    if is01 then return "01staff" end
    if inMain then return "main" end
    if isU    then return "undercover" end
    if inPossible then return "possible" end
    return nil
end

function classifyStaffPlayer(player)
    if not player then return nil end
    local mains      = getMainMemberships(player)
    local possible   = getPossibleMemberships(player)
    local inMain     = #mains > 0
    local inPossible = #possible > 0
    local isU        = isUndercover(player, inMain)
    local is01       = is01Staff(player)
    local ownerPlayer = isOwner(player)
    return {
        mains = mains,
        possible = possible,
        inMain = inMain,
        inPossible = inPossible,
        isUndercover = isU,
        is01 = is01,
        owner = ownerPlayer,
        category = getPlayerCategory(inMain, isU, inPossible, is01, ownerPlayer),
    }
end

function classificationPriority(category)
    return ({
        owner = 5,
        ["01staff"] = 4,
        main = 3,
        undercover = 2,
        possible = 1,
    })[category] or 0
end

local autoKickTriggered = false

function getAutoKickRole(player)
    if not player or player == localPlayer then return nil end
    if isOwner(player) then return nil end
    local mains = getMainMemberships(player)
    local inMain = #mains > 0
    if inMain then
        return "staff"
    end

    -- Possible-staff membership is intentionally not enough to trigger this.
    if isUndercover(player, false) then
        return "undercover"
    end
    return nil
end

function autoKickPlayerIfNeeded(player)
    if not config.AutoKickEnabled
        or autoKickTriggered
        or not player
        or player == localPlayer
        or not player.Parent then
        return false
    end

    local role = getAutoKickRole(player)
    if not role then return false end

    autoKickTriggered = true
    local roleLabel = role == "undercover" and "undercover staff" or "staff"
    notify(
        "AUTO KICK",
        roleLabel .. " detected: " .. getDisplayName(player) .. "\nLeaving this server.",
        4,
        "warning",
        nil,
        true
    )

    task.delay(0.25, function()
        pcall(function()
            localPlayer:Kick("Auto Kick: " .. roleLabel .. " joined the server.")
        end)
    end)
    return true
end

function checkExistingPlayersForAutoKick()
    for _, player in ipairs(Players:GetPlayers()) do
        if autoKickPlayerIfNeeded(player) then break end
    end
end

local ROLE_TAG_NAME = "StaffAlertRoleTag"
local roleDisplayState = setmetatable({}, {__mode = "k"})

local function removeRoleTag(character)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local legacyTag = character and character:FindFirstChild(ROLE_TAG_NAME)
    if legacyTag then legacyTag:Destroy() end
    local saved = humanoid and roleDisplayState[humanoid]
    if saved then
        if saved.GuardConnection then
            saved.GuardConnection:Disconnect()
            saved.GuardConnection = nil
        end
        humanoid.DisplayName = saved.DisplayName
        humanoid.DisplayDistanceType = saved.DisplayDistanceType
        roleDisplayState[humanoid] = nil
    end
end

local function updateRoleTag(player, category, character)
    if not character or (category ~= "owner" and category ~= "01staff") then
        removeRoleTag(character)
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        task.spawn(function()
            local readyHumanoid = character:WaitForChild("Humanoid", 10)
            if readyHumanoid and character.Parent and player.Parent then
                updateRoleTag(player, category, character)
            end
        end)
        return
    end
    local legacyTag = character:FindFirstChild(ROLE_TAG_NAME)
    if legacyTag then legacyTag:Destroy() end
    if not roleDisplayState[humanoid] then
        roleDisplayState[humanoid] = {
            DisplayName = humanoid.DisplayName,
            DisplayDistanceType = humanoid.DisplayDistanceType,
        }
    end
    local saved = roleDisplayState[humanoid]
    if not saved.GuardConnection then
        saved.GuardConnection = humanoid:GetPropertyChangedSignal("DisplayName"):Connect(function()
            if not character.Parent or not player.Parent then return end
            if not config.OneStaffTagsEnabled then return end
            local expected = (category == "owner" and "[👑]" or "[🛡️]") .. player.DisplayName
            if humanoid.DisplayName ~= expected then
                humanoid.DisplayName = expected
            end
        end)
    end
    local showTag = config.OneStaffTagsEnabled
    humanoid.DisplayName = showTag
        and ((category == "owner" and "[👑]" or "[🛡️]") .. player.DisplayName)
        or saved.DisplayName
    humanoid.DisplayDistanceType = showTag
        and Enum.HumanoidDisplayDistanceType.Viewer
        or saved.DisplayDistanceType
end

local function applyESP(player, classification)
    if not player or not player.Parent then return end

    classification = classification or classifyStaffPlayer(player)
    if not classification then return end
    state.StaffClassificationCache[player.UserId] = classification
    local mains      = classification.mains
    local possible   = classification.possible
    local inPossible = classification.inPossible
    local category   = classification.category
    local oldPossibleHighlight = state.PossibleESPFolder:FindFirstChild("PHL_" .. player.UserId)
    if oldPossibleHighlight then oldPossibleHighlight:Destroy() end

    if not category then
        removeRoleTag(player.Character)
        return
    end

    local function attach(char)
        if not char then return end
        if category == "possible" then
            removeRoleTag(char)
            return
        end
        local key, folder, fillClr, outlineClr
        if category == "owner" then
            key    = "OWNERHL_" .. player.UserId
            folder = state.StaffESPFolder
            fillClr    = theme.Owner
            outlineClr = theme.Owner
        elseif category == "01staff" then
            key    = "O1HL_"  .. player.UserId
            folder = state.StaffESPFolder
            fillClr    = theme.OneStaff
            outlineClr = theme.OneStaff
        elseif category == "main" then
            key    = "HL_"  .. player.UserId
            folder = state.StaffESPFolder
            fillClr    = theme.Success
            outlineClr = theme.Success
        elseif category == "undercover" then
            key    = "UHL_" .. player.UserId
            folder = state.UndercoverESPFolder
            fillClr    = Color3.fromRGB(255, 0, 0)
            outlineClr = Color3.fromRGB(255, 0, 0)
        else
            key    = "PHL_" .. player.UserId
            folder = state.PossibleESPFolder
            fillClr    = theme.PossibleStaff
            outlineClr = theme.PossibleStaff
        end
        local oldHl = folder:FindFirstChild(key)
        if oldHl then oldHl:Destroy() end
        local hl = Instance.new("Highlight", folder)
        hl.Name = key
        hl.Adornee = char
        hl.FillTransparency = 0.55
        hl.OutlineTransparency = 0.1
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Enabled = config.StaffESPEnabled
            and (category ~= "01staff" and category ~= "owner" or config.OneStaffESPEnabled)
        if fillClr    then hl.FillColor    = fillClr    end
        if outlineClr then hl.OutlineColor = outlineClr end
        updateRoleTag(player, category, char)
    end

    if category == "owner" then
        local title, body, color = buildNotif(player, "joined", mains, possible)
        notify(title, body, 6, nil, color, true, 3, true)
        playSound("rbxassetid://8887499160", 2.4)
    elseif category == "01staff" then
        local title, body, color = buildNotif(player, "joined", mains, possible)
        notify(title, body, 5, nil, color)
        playSound("rbxassetid://8887499160", 2)
    elseif category == "main" then
        local title, body, color = buildNotif(player, "joined", mains, possible)
        notify(title, body, 5, nil, color)
        playSound("rbxassetid://8887499160", 2)
    elseif category == "undercover" then
        local dn = getDisplayName(player)
        local body = dn .. " (@" .. player.Name .. ") is here!"
        if inPossible then
            local parts = {}
            for _, m in ipairs(possible) do
                table.insert(parts, getGroupName(m.id) .. ": " .. m.role)
            end
            body = body .. " | Also in: " .. table.concat(parts, ", ")
        end
        notify("⚠ UNDERCOVER STAFF", body, 6, "warning")
        playSound("rbxassetid://8887499160", 2)
    else
        local title, body, _ = buildNotif(player, "joined", nil, possible)
        notify(title, body, 5, nil, theme.PossibleStaff)
    end

    if player.Character then attach(player.Character) end
    player.CharacterAdded:Connect(attach)
end

local function setOneStaffESPEnabled(value)
    config.OneStaffESPEnabled = value
    saveSettingWithNotice("OneStaffESPEnabled", value, "PROFILE")
    for _, highlight in ipairs(state.StaffESPFolder:GetChildren()) do
        if highlight:IsA("Highlight")
            and (highlight.Name:match("^O1HL_") or highlight.Name:match("^OWNERHL_")) then
            highlight.Enabled = config.StaffESPEnabled and value
        end
    end
end

local function setOneStaffTagsEnabled(value)
    config.OneStaffTagsEnabled = value
    saveSettingWithNotice("OneStaffTagsEnabled", value, "PROFILE")
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        if player ~= localPlayer and character then
            local category = isOwner(player) and "owner"
                or (is01Staff(player) and "01staff" or nil)
            if category then
                updateRoleTag(player, category, character)
            else
                removeRoleTag(character)
            end
        end
    end
end

local function onPlayerRemoving(player)
    local classification = state.StaffClassificationCache[player.UserId]
        or classifyStaffPlayer(player)
    if classification and not classification.category then
        -- A departing Player can still answer group requests for a brief
        -- window. Retry before giving up so a late group response is not lost.
        for _ = 1, 3 do
            if classification.category then break end
            task.wait(0.2)
            local latest = classifyStaffPlayer(player)
            if classificationPriority(latest.category) > classificationPriority(classification.category) then
                classification = latest
            end
        end
    end
    state.StaffClassificationCache[player.UserId] = nil
    if not classification then return end
    local mains      = classification.mains
    local possible   = classification.possible
    local inPossible = classification.inPossible
    local category   = classification.category

    if not category then return end

    if category == "owner" then
        playSound("rbxassetid://1091083826", 2)
        local title, body, color = buildNotif(player, "left", mains, possible)
        notify(title, body, 5, nil, color, true, 3, true)
        local hl = state.StaffESPFolder:FindFirstChild("OWNERHL_" .. player.UserId)
        if hl then hl:Destroy() end
    elseif category == "01staff" then
        playSound("rbxassetid://1091083826", 2)
        local title, body, color = buildNotif(player, "left", mains, possible)
        notify(title, body, 5, nil, color)
        local hl = state.StaffESPFolder:FindFirstChild("O1HL_" .. player.UserId)
        if hl then hl:Destroy() end
    elseif category == "main" then
        playSound("rbxassetid://1091083826", 2)
        local title, body, color = buildNotif(player, "left", mains, possible)
        notify(title, body, 5, nil, color)
        local hl = state.StaffESPFolder:FindFirstChild("HL_" .. player.UserId)
        if hl then hl:Destroy() end
    elseif category == "undercover" then
        playSound("rbxassetid://1091083826", 2)
        local dn = getDisplayName(player)
        local body = dn .. " has left the server."
        if inPossible then
            local parts = {}
            for _, m in ipairs(possible) do
                table.insert(parts, getGroupName(m.id) .. ": " .. m.role)
            end
            body = body .. " | Was in: " .. table.concat(parts, ", ")
        end
        notify("UNDERCOVER PLAYER LEFT", body, 5, "warning")
        local hl = state.UndercoverESPFolder:FindFirstChild("UHL_" .. player.UserId)
        if hl then hl:Destroy() end
    else
        local title, body, _ = buildNotif(player, "left", nil, possible)
        notify(title, body, 5, nil, theme.PossibleStaff)
        local hl = state.PossibleESPFolder:FindFirstChild("PHL_" .. player.UserId)
        if hl then hl:Destroy() end
    end
end

