-- === NOTIFICATIONS ===
function updateNotifPositions()
    local stackOffset = 0
    for i, notif in ipairs(state.Notifications) do
        local targetPos = UDim2.new(1, -320, 0.95, -stackOffset)
        tween(notif, {Position = targetPos}, 0.3)
        stackOffset = stackOffset + notif.Size.Y.Offset + 10
    end
end

-- outlineColor (5th arg) overrides the type-based color when provided
-- force (6th arg) bypasses the NotificationsEnabled toggle (used for manual staff checks)
-- fitLines (7th arg) gives a notification enough height for every explicit line.
function notify(title, text, duration, type, outlineColor, force, fitLines, glint)
    if not config.NotificationsEnabled and not force then return end
    local color
    if outlineColor then
        color = outlineColor
    elseif type == "success" then
        color = theme.Success
    elseif type == "warning" then
        color = theme.Warning
    else
        color = theme.AccentSecondary
    end

    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = theme.BackgroundPrimary
    frame.Position = UDim2.new(1, 20, 0.95, 0)
    local bodyHeight = math.max(35, (fitLines or 2) * 18)
    local frameHeight = 35 + bodyHeight + 10
    frame.Size = UDim2.new(0, 300, 0, frameHeight)
    frame.AnchorPoint = Vector2.new(0, 1)
    frame.ZIndex = 10000
    frame.Parent = CoreGui.RobloxGui:FindFirstChild(ids.gui) or CoreGui.RobloxGui

    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = color
    stroke.Thickness = 2
    addGlow(frame, color, 0.6)
    if glint then
        local glintBar = Instance.new("Frame", frame)
        glintBar.BackgroundColor3 = Color3.fromRGB(255, 255, 215)
        glintBar.BackgroundTransparency = 0.28
        glintBar.BorderSizePixel = 0
        glintBar.Position = UDim2.new(0, -80, 0, 0)
        glintBar.Size = UDim2.new(0, 52, 1, 0)
        glintBar.Rotation = 18
        glintBar.ZIndex = 10002
        task.spawn(function()
            while glintBar.Parent do
                glintBar.Position = UDim2.new(0, -80, 0, 0)
                tween(glintBar, {Position = UDim2.new(1, 25, 0, 0)}, 1.15, Enum.EasingStyle.Linear)
                task.wait(2.2)
            end
        end)
    end

    local tl = Instance.new("TextLabel", frame)
    tl.BackgroundTransparency = 1
    tl.Position = UDim2.new(0, 15, 0, 10)
    tl.Size = UDim2.new(1, -30, 0, 22)
    tl.Font = Enum.Font.GothamBold
    tl.Text = title
    tl.TextColor3 = color
    tl.TextSize = 16
    tl.TextXAlignment = Enum.TextXAlignment.Left
    tl.ZIndex = 10001

    local bl = Instance.new("TextLabel", frame)
    bl.BackgroundTransparency = 1
    bl.Position = UDim2.new(0, 15, 0, 35)
    bl.Size = UDim2.new(1, -30, 0, bodyHeight)
    bl.Font = Enum.Font.Gotham
    bl.Text = text
    bl.TextColor3 = theme.TextSecondary
    bl.TextSize = 13
    bl.TextWrapped = true
    bl.TextXAlignment = Enum.TextXAlignment.Left
    bl.TextYAlignment = Enum.TextYAlignment.Top
    bl.ZIndex = 10001

    table.insert(state.Notifications, 1, frame)
    updateNotifPositions()

    task.delay(duration or 3, function()
        tween(frame, {Position = UDim2.new(1, 20, frame.Position.Y.Scale, frame.Position.Y.Offset)}, 0.4)
        task.wait(0.4)
        local idx = table.find(state.Notifications, frame)
        if idx then
            table.remove(state.Notifications, idx)
            updateNotifPositions()
        end
        frame:Destroy()
    end)
end

-- === PERSISTENT SETTINGS ===
-- File APIs are preferred when the executor exposes them. getgenv provides a
-- session fallback so settings still remain stable after the menu is rebuilt.
local SETTINGS_FILE = "VF_StaffAlert_Settings.txt"
local settingsEnv = {}
pcall(function()
    settingsEnv = type(getgenv) == "function" and getgenv() or _G
end)
if type(settingsEnv) ~= "table" then settingsEnv = {} end

function encodeSetting(value)
    if value == nil then return "" end
    if type(value) == "boolean" then return value and "true" or "false" end
    return tostring(value)
end

function decodeSetting(raw, default)
    if raw == nil or raw == "" then return default end
    if type(default) == "boolean" then
        return tostring(raw):lower() == "true"
    elseif type(default) == "number" then
        return tonumber(raw) or default
    end
    return raw
end

function loadSetting(name, default)
    local value = settingsEnv[name]
    if value ~= nil then return decodeSetting(value, default) end
    if type(isfile) == "function" and type(readfile) == "function" then
        local ok, raw = pcall(function()
            if not isfile(SETTINGS_FILE) then return nil end
            local contents = readfile(SETTINGS_FILE)
            for line in string.gmatch(contents, "[^\r\n]+") do
                local key, stored = line:match("^([^=]+)=(.*)$")
                if key == name then return stored end
            end
            return nil
        end)
        if ok and raw ~= nil then return decodeSetting(raw, default) end
    end
    return default
end

function saveSetting(name, value)
    settingsEnv[name] = encodeSetting(value)
    if type(writefile) ~= "function" then return true end

    local values = {}
    if type(isfile) == "function" and type(readfile) == "function" then
        pcall(function()
            if isfile(SETTINGS_FILE) then
                for line in string.gmatch(readfile(SETTINGS_FILE), "[^\r\n]+") do
                    local key, stored = line:match("^([^=]+)=(.*)$")
                    if key and key ~= name then values[key] = stored end
                end
            end
        end)
    end
    values[name] = encodeSetting(value)

    local lines = {}
    for key, stored in pairs(values) do
        table.insert(lines, key .. "=" .. stored)
    end
    table.sort(lines)
    local ok = pcall(function() writefile(SETTINGS_FILE, table.concat(lines, "\n")) end)
    return ok
end

function saveSettingWithNotice(name, value, title)
    if not saveSetting(name, value) then
        notify(title or "SETTINGS", "Could not save this setting.", 3, "warning")
        return false
    end
    return true
end

