    local function commit()
        local value = tonumber(box.Text)
        if not value then
            box.Text = tostring(initialValue)
            return
        end
        value = math.clamp(value, minValue, maxValue)
        box.Text = tostring(value)
        initialValue = value
        callback(value)
    end

