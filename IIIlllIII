-- Clear all player rows from a section (leaves emptyLbl intact)
local function slClear(sf)
    for _, c in ipairs(sf:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
end

-- Populate a section: add rows and update CanvasSize + counter header
local function slPopulate(entries, sf, emptyLbl, color, hdr, title)
    slClear(sf)
    emptyLbl.Visible = (#entries == 0)
    for i, e in ipairs(entries) do
        slAddRow(sf, i, e.display, e.detail, e.color or color)
    end
    -- Set CanvasSize explicitly so the ScrollingFrame knows how tall the content is
    local totalH = #entries * SL_STRIDE + 12
    sf.CanvasSize = UDim2.new(1, 0, 0, totalH)
    hdr.Text = title .. " [" .. #entries .. "]"
end

refreshStaffList = function()
    slClear(slOneSF)
    slClear(slMainSF)
    slClear(slUndSF)
    slClear(slPossSF)

    local oneStaffEntries = {}
    local mainEntries = {}
    local undEntries  = {}
    local possEntries = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer then continue end
        local mains      = getMainMemberships(p)
        local possible   = getPossibleMemberships(p)
        local inMain     = #mains > 0
        local inPossible = #possible > 0
        local isU        = isUndercover(p, inMain)
        local is01       = is01Staff(p)
        local ownerPlayer = isOwner(p)
        local category   = getPlayerCategory(inMain, isU, inPossible, is01, ownerPlayer)
        if not category then continue end

        local nameText = getDisplayName(p) .. " (@" .. p.Name .. ")"

        if category == "owner" then
            table.insert(oneStaffEntries, {
                name = p.Name,
                sortKey = p.DisplayName:lower() .. "\0" .. p.Name:lower(),
                display = nameText,
                detail = "👑 OVERSEER",
                color = theme.Owner,
            })
        elseif category == "01staff" then
            table.insert(oneStaffEntries, {
                name = p.Name,
                sortKey = p.DisplayName:lower() .. "\0" .. p.Name:lower(),
                display = nameText,
                detail = "ADMIN • 01 STAFF",
                color = theme.OneStaff,
            })
        elseif inMain then
            local mainParts = {}
            for _, m in ipairs(mains) do table.insert(mainParts, getGroupName(m.id) .. ": " .. m.role) end
            local detail = table.concat(mainParts, "  |  ")
            if inPossible then
                local extras = {}
                for _, m in ipairs(possible) do table.insert(extras, getGroupName(m.id) .. ": " .. m.role) end
                detail = detail .. "  |  " .. table.concat(extras, "  |  ")
            end
            table.insert(mainEntries, {
                name = p.Name,
                sortKey = p.DisplayName:lower() .. "\0" .. p.Name:lower(),
                display = nameText,
                detail = detail,
            })
        end

        if isU and not inMain then
            local detail = "⚠ UNDERCOVER"
            if inPossible then
                local extras = {}
                for _, m in ipairs(possible) do table.insert(extras, getGroupName(m.id) .. ": " .. m.role) end
                detail = detail .. "  |  " .. table.concat(extras, "  |  ")
            end
            table.insert(undEntries, {
                name = p.Name,
                sortKey = p.DisplayName:lower() .. "\0" .. p.Name:lower(),
                display = nameText,
                detail = detail,
            })
        end

        if inPossible then
            local parts = {}
            for _, m in ipairs(possible) do table.insert(parts, getGroupName(m.id) .. ": " .. m.role) end
            table.insert(possEntries, {
                name = p.Name,
                sortKey = p.DisplayName:lower() .. "\0" .. p.Name:lower(),
                display = nameText,
                detail = table.concat(parts, "  |  "),
            })
        end
    end

    local function sortAlpha(t)
        table.sort(t, function(a, b)
            return (a.sortKey or a.name:lower()) < (b.sortKey or b.name:lower())
        end)
    end
    sortAlpha(oneStaffEntries) sortAlpha(mainEntries) sortAlpha(undEntries) sortAlpha(possEntries)
-- xx Subtitles staff list
    slPopulate(oneStaffEntries, slOneSF, slOneEmpty, theme.OneStaff, slOneHdr, "— 01 STAFF")
    slPopulate(mainEntries, slMainSF, slMainEmpty, theme.Success, slMainHdr, "— VF STAFF GROUP [MAIN]")
    slPopulate(undEntries,  slUndSF,  slUndEmpty,  theme.Warning,       slUndHdr,  "— UNDERCOVER STAFF [HIGH CHANCE]")
    slPopulate(possEntries, slPossSF, slPossEmpty, theme.PossibleStaff, slPossHdr, "— POSSIBLE STAFF GROUP [LOW CHANCE]")
end

-- Refresh when the page is opened
staffListPage:GetPropertyChangedSignal("Visible"):Connect(function()
    if staffListPage.Visible then pcall(refreshStaffList) end
end)
