function stompEffects.DestroyLater(instance, delaySeconds)
    task.delay(delaySeconds, function()
        if instance and instance.Parent then
            instance:Destroy()
        end
    end)
end

function stompEffects.CreateDisc(position, color, startDiameter, endDiameter, lifetime, transparency)
    local disc = Instance.new("Part")
    disc.Name = "FreeStompEffect"
    disc.Anchored = true
    disc.CanCollide = false
    disc.CanQuery = false
    disc.CanTouch = false
    disc.CastShadow = false
    disc.Material = Enum.Material.Neon
    disc.Shape = Enum.PartType.Cylinder
    disc.Color = color
    disc.Transparency = transparency
    disc.Size = Vector3.new(0.06, startDiameter, startDiameter)
    disc.CFrame = CFrame.new(position + Vector3.new(0, 0.04, 0))
        * CFrame.Angles(0, 0, math.rad(90))
    disc.Parent = Workspace

    TweenService:Create(
        disc,
        TweenInfo.new(lifetime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {
            Size = Vector3.new(0.03, endDiameter, endDiameter),
            Transparency = 1,
        }
    ):Play()
    stompEffects.DestroyLater(disc, lifetime + 0.1)
end

function stompEffects.IsEnabled()
    -- Only an explicit Profile toggle-off disables the effect. A fresh script
    -- execution always starts enabled and never loads a saved opt-out.
    return config.OverseerStompEffectsEnabled ~= false
end

function stompEffects.ClearConnections()
    if stompEffects.InputConnection then
        stompEffects.InputConnection:Disconnect()
        stompEffects.InputConnection = nil
    end
    for _, connection in ipairs(stompEffects.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(stompEffects.Connections)
    stompEffects.CancelPending()
end

