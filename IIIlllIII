local function createToggle(name, desc, yPos, initialValue, callback, parent, onColor, offColor)
    local enabledColor = onColor or theme.AccentPrimary
    local disabledColor = offColor or Color3.fromRGB(70, 59, 96)
    local f = Instance.new("Frame", parent or staffPage)
    f.BackgroundColor3 = theme.BackgroundSecondary
